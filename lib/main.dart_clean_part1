class TutorialOverlayPainter extends CustomPainter {
  final int currentStep;
  final Size screenSize;

  TutorialOverlayPainter({
    required this.currentStep,
    required this.screenSize,
  });

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.black.withOpacity(0.95)
      ..style = PaintingStyle.fill;

    final path = Path()..addRect(Rect.fromLTWH(0, 0, size.width, size.height));

    // Highlight Bereich basierend auf Step
    Rect highlightRect;
    
    if (currentStep == 0) {
      // Home: Mitte des Bildschirms (Gebete)
      highlightRect = Rect.fromLTWH(
        20,
        size.height * 0.35,
        size.width - 40,
        size.height * 0.3,
      );
    } else if (currentStep == 1) {
      // Step 1: Ganze untere Navigation Bar markieren
      highlightRect = Rect.fromLTWH(
        0,
        size.height - 80,
        size.width,
        80,
      );
    } else {
      // Tabs: Einzelne Tabs
      final tabWidth = size.width / 4;
      final tabIndex = currentStep - 1;
      highlightRect = Rect.fromLTWH(
        tabIndex * tabWidth,
        size.height - 80,
        tabWidth,
        80,
      );
    }

    final highlightPath = Path()
      ..addRRect(
        RRect.fromRectAndRadius(
          highlightRect,
          const Radius.circular(8),
        ),
      );

    path.addPath(highlightPath, Offset.zero);
    canvas.drawPath(path, paint..blendMode = BlendMode.difference);

    // Goldener Rand um Highlight (dünner)
    canvas.drawRRect(
      RRect.fromRectAndRadius(highlightRect, const Radius.circular(8)),
      Paint()
        ..color = appThemeColor
        ..style = PaintingStyle.stroke
        ..strokeWidth = 2,
    );
  }

  @override
  bool shouldRepaint(covariant TutorialOverlayPainter oldDelegate) {
    return oldDelegate.currentStep != currentStep;
  }
}

